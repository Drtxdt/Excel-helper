[
  {
    "id": "fn-sum",
    "version": 1,
    "name": "SUM",
    "title": "求和",
    "syntax": "SUM(数值1, [数值2], …)",
    "example": "=SUM(B2:B5)",
    "note": "区域里的文本和空白通常被忽略，新增数据时检查范围有没有覆盖。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-round",
    "version": 1,
    "name": "ROUND",
    "title": "金额保留小数",
    "syntax": "ROUND(数值, 位数)",
    "example": "=ROUND(B2*C2,2)",
    "note": "设置显示两位小数并不改变参与后续计算的原值；ROUND 会改变结果。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-average",
    "version": 1,
    "name": "AVERAGE",
    "title": "算术平均值",
    "syntax": "AVERAGE(数值1, …)",
    "example": "=AVERAGE(B2:B5)",
    "note": "区域里的零参与平均；空白不计入分母。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-min",
    "version": 1,
    "name": "MIN",
    "title": "找最小值",
    "syntax": "MIN(数值1, …)",
    "example": "=MIN(B2:B5)",
    "note": "零也是一个数，不会被忽略。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-max",
    "version": 1,
    "name": "MAX",
    "title": "找最大值",
    "syntax": "MAX(数值1, …)",
    "example": "=MAX(B2:B5)",
    "note": "检查范围是否包含整列记录。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-count",
    "version": 1,
    "name": "COUNT",
    "title": "数一数数字",
    "syntax": "COUNT(值1, …)",
    "example": "=COUNT(B2:B5)",
    "note": "数字与看起来像数字的文本是不同类型。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-counta",
    "version": 1,
    "name": "COUNTA",
    "title": "统计非空单元格",
    "syntax": "COUNTA(值1, …)",
    "example": "=COUNTA(B2:B5)",
    "note": "公式返回的空字符串也可能计数；有内容不等于有有效数据。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-if",
    "version": 1,
    "name": "IF",
    "title": "按条件选结果",
    "syntax": "IF(条件, 成立时的值, 不成立时的值)",
    "example": "=IF(B2<10,\"补货\",\"够用\")",
    "note": "文本要放在英文双引号里；小于 10 不包含 10。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-and",
    "version": 1,
    "name": "AND",
    "title": "所有条件同时成立",
    "syntax": "AND(条件1, 条件2, …)",
    "example": "=AND(B2<10,C2=0)",
    "note": "返回 TRUE 或 FALSE，可以交给 IF 继续处理。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-or",
    "version": 1,
    "name": "OR",
    "title": "至少一个条件成立",
    "syntax": "OR(条件1, 条件2, …)",
    "example": "=OR(B2<10,D2>20)",
    "note": "两个条件都成立时也会返回 TRUE。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-iferror",
    "version": 1,
    "name": "IFERROR",
    "title": "处理错误值",
    "syntax": "IFERROR(表达式, 出错时的值)",
    "example": "=IFERROR(B2/C2,\"暂无消耗\")",
    "note": "先理解错误原因，再决定替代值。不要把所有错误都藏成零。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-trim",
    "version": 1,
    "name": "TRIM",
    "title": "清理多余空格",
    "syntax": "TRIM(文本)",
    "example": "=TRIM(A2)",
    "note": "去掉首尾普通空格，词间多个普通空格压缩成一个；不保证清除所有 Unicode 空白。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-value",
    "version": 1,
    "name": "VALUE",
    "title": "把文本转换成数值",
    "syntax": "VALUE(文本)",
    "example": "=VALUE(A2)",
    "note": "货号中的前导零有意义，别把货号当数值转换。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-left",
    "version": 1,
    "name": "LEFT",
    "title": "从左侧取字符",
    "syntax": "LEFT(文本, 字符数)",
    "example": "=LEFT(A2,2)",
    "note": "返回文本，哪怕它看起来是数字。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-mid",
    "version": 1,
    "name": "MID",
    "title": "从指定位置取字符",
    "syntax": "MID(文本, 起始位置, 字符数)",
    "example": "=MID(A2,4,3)",
    "note": "起始位置从 1 开始。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-right",
    "version": 1,
    "name": "RIGHT",
    "title": "从右侧取字符",
    "syntax": "RIGHT(文本, 字符数)",
    "example": "=RIGHT(A2,1)",
    "note": "先确认编码长度与分隔符是否稳定。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-date",
    "version": 1,
    "name": "DATE",
    "title": "组合日期",
    "syntax": "DATE(年, 月, 日)",
    "example": "=DATE(A2,B2,C2)",
    "note": "日期以序列值参与计算，显示格式决定看到日期还是数字。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-xlookup",
    "version": 1,
    "name": "XLOOKUP",
    "title": "按键查找对应值",
    "syntax": "XLOOKUP(查找值, 查找区域, 返回区域, [未找到时的值])",
    "example": "=XLOOKUP(A2,商品!A2:A4,商品!C2:C4,\"未登记\")",
    "note": "默认精确匹配；重复键默认取第一个，不会替你发现数据冲突。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-vlookup",
    "version": 1,
    "name": "VLOOKUP",
    "title": "从区域首列向右查找",
    "syntax": "VLOOKUP(查找值, 表区域, 返回列序号, FALSE)",
    "example": "=VLOOKUP(A2,商品!A2:C4,3,FALSE)",
    "note": "本课程使用 FALSE 精确匹配；返回列序号从表区域的第一列计起。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-sumif",
    "version": 1,
    "name": "SUMIF",
    "title": "单条件求和",
    "syntax": "SUMIF(条件区域, 条件, 求和区域)",
    "example": "=SUMIF(A2:A6,\"东街\",C2:C6)",
    "note": "条件区域与求和区域要对应同一批记录。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-countif",
    "version": 1,
    "name": "COUNTIF",
    "title": "单条件计数",
    "syntax": "COUNTIF(条件区域, 条件)",
    "example": "=COUNTIF(A2:A6,\"东街\")",
    "note": "返回满足条件的单元格数量。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-sumifs",
    "version": 1,
    "name": "SUMIFS",
    "title": "多条件求和",
    "syntax": "SUMIFS(求和区域, 条件区域1, 条件1, …)",
    "example": "=SUMIFS(C2:C6,A2:A6,\"东街\",B2:B6,\"已发货\")",
    "note": "SUMIFS 把求和区域放在第一个参数；所有条件需要同时成立。",
    "source": "表格补给站原创",
    "license": "MIT"
  },
  {
    "id": "fn-countifs",
    "version": 1,
    "name": "COUNTIFS",
    "title": "多条件计数",
    "syntax": "COUNTIFS(条件区域1, 条件1, …)",
    "example": "=COUNTIFS(A2:A6,\"东街\",B2:B6,\"已发货\")",
    "note": "每个条件区域要有相同尺寸。",
    "source": "表格补给站原创",
    "license": "MIT"
  }
]
