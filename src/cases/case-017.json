      "solutions": [
        {
          "title": "查找与多条件汇总",
          "cells": {
            "investigation!B2": "=XLOOKUP(A2,标签!A2:A4,标签!B2:B4)",
            "investigation!C2": "=SUMIFS(调拨!C2:C4,调拨!D2:D4,B2,调拨!E2:E4,\"有效\")",
            "investigation!D2": "=SUMIFS(调拨!C2:C4,调拨!D2:D4,B2,调拨!E2:E4,\"撤回\")",
            "investigation!E2": "=XLOOKUP(B2&\"|有效\",调拨!A2:A4,调拨!B2:B4)"
          },
          "explanation": "先换标签，再分状态计算。撤回记录保留用于解释过程，不累加到有效签收。"
        },
        {
